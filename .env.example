# Postback secret key from the Postback page of your Moonetix dashboard.
# It is not the link hash salt. Keep it on your server only.
MOONETIX_POSTBACK_KEY=replace_with_your_postback_secret_key

# Where the handler listens (Node, Python, Java). Put a reverse proxy with HTTPS in front of it.
HOST=127.0.0.1
PORT=8080

# SQLite file (PHP, Node, Python). Defaults to data/moonetix.sqlite in the handler folder.
# Keep it outside your web root.
# DB_PATH=/var/lib/moonetix/moonetix.sqlite
